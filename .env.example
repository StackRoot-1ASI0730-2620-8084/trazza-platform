# Trazza Platform - copy this file as .env and fill in your values (.env is never committed)

# Database (AWS RDS)
DATABASE_URL=your-rds-endpoint.us-east-1.rds.amazonaws.com
DATABASE_USER=your_user
DATABASE_PASSWORD=your_password
DATABASE_SCHEMA=trazza_database

# JWT (at least 32 characters)
TokenSettings__Secret=your_long_random_secret

# Personal data protection (Base64 keys of 32 bytes: openssl rand -base64 32)
PersonalData__EncryptionKey=your_base64_key
PersonalData__HashKey=your_base64_key
