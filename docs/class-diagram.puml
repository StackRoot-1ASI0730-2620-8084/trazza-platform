@startuml Trazza.Platform Class Diagram

title
    Trazza.Platform
    Class Diagram (v1.0.0)
    Shared, IAM, Matchmaking, Execution, Billing, Reputation
end title

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Shared Bounded Context" as Shared {
    interface "IEntityId<T>" as IEntityId {
        +Value: T
    }
    interface IEvent
    interface IAggregateRoot {
        +DomainEvents: IReadOnlyCollection<IEvent>
        +ClearDomainEvents(): void
    }
    abstract class AggregateRoot implements IAggregateRoot {
        -domainEvents: List<IEvent>
        #AddDomainEvent(domainEvent: IEvent): void
    }
    interface IAuditableEntity {
        +CreatedAt: DateTimeOffset?
        +UpdatedAt: DateTimeOffset?
    }
    enum EErrorType {
        Failure
        Validation
        NotFound
        Conflict
        Unauthorized
        Forbidden
        Unexpected
    }
    class Error <<record>> {
        +Code: string
        +Message: string
        +Type: EErrorType
    }
    class "Result<T>" as Result {
        +IsSuccess: bool
        +Value: T?
        +DomainError: Error
        +Match(onSuccess, onFailure): TResult
    }
    class Money <<value object>> {
        +Amount: decimal
        +Currency: string
        +IsValid: bool
        +Formatted: string
        +Add(other: Money): Money
        +Multiply(factor: decimal): Money
    }
    class Address <<value object>> {
        +Street: string
        +District: string
        +IsValid: bool
        +Location: GeoLocation
    }
    class GeoLocation <<value object>> {
        +Latitude: double
        +Longitude: double
        +DistanceTo(other: GeoLocation): double
    }
    Result --> Error
    Error --> EErrorType
    Address ..> GeoLocation
}

package "IAM Bounded Context" as Iam {
    class User <<aggregate root>> {
        +Id: long
        +PublicId: Guid
        +Email: string
        +Phone: string
        +PasswordHash: string
        +Status: EAccountStatus
    }
    class PersonIdentity <<aggregate root>> {
        +Id: long
        +UserId: long
        +DocumentType: EIdentityDocumentType
        +DocumentNumberCiphertext: byte[]
        +DocumentNumberHash: byte[]
        +FirstName: string
        +LastName: string
    }
    class IdentityVerification <<aggregate root>> {
        +Id: long
        +UserId: long
        +Status: EVerificationStatus
    }
    class CarrierProfile <<aggregate root>> {
        +UserId: long
        +AverageRating: decimal
        +CompletedTripsCount: int
    }
    class MerchantProfile <<aggregate root>> {
        +UserId: long
        +BusinessName: string?
        +AverageRating: decimal
    }
    class Vehicle <<aggregate root>> {
        +Id: long
        +PublicId: Guid
        +CarrierUserId: long
        +PlateNumber: string
        +Brand: string
        +Model: string
        +BodyType: EVehicleBodyType
        +MaxWeightKg: decimal
        +MaxVolumeM3: decimal
        +Status: EVehicleStatus
    }
    class Driver <<aggregate root>> {
        +Id: long
        +CarrierUserId: long
        +FullName: string
        +LicenseNumber: string
        +LicenseCategory: string
        +Status: EDriverStatus
    }
    class SavedAddress <<aggregate root>> {
        +Id: long
        +UserId: long
        +Label: string
        +District: string
        +StreetLine: string
    }
    interface IUserCommandService
    interface IUserQueryService
    interface IFleetCommandService
    interface IFleetQueryService
    interface IIamContextFacade
    User "1" -- "0..1" PersonIdentity
    User "1" -- "0..1" CarrierProfile
    User "1" -- "0..1" MerchantProfile
    CarrierProfile "1" -- "0..*" Vehicle
    CarrierProfile "1" -- "0..*" Driver
    User "1" -- "0..*" SavedAddress
}

package "Matchmaking Bounded Context" as Matchmaking {
    class ReturnRoute <<aggregate root>> {
        +Id: ReturnRouteId
        +PublicId: Guid
        +CarrierId: CarrierId
        +VehicleId: VehicleId
        +Origin: RouteStop
        +Destination: RouteStop
        +CorridorRadiusKm: decimal
        +DepartureWindow: TimeWindow
        +AvailableWeightKg: decimal
        +AvailableVolumeM3: decimal
        +SuggestedPriceAmount: decimal?
        +Status: ERouteStatus
        +ReserveCapacity(weightKg, volumeM3): Error
        +Cancel(): Error
    }
    class ShipmentRequest <<aggregate root>> {
        +Id: ShipmentRequestId
        +PublicId: Guid
        +MerchantId: MerchantId
        +Origin: RouteStop
        +Destination: RouteStop
        +PickupWindow: TimeWindow
        +Cargo: Cargo
        +MaxBudgetAmount: decimal?
        +Status: ERequestStatus
        +MarkMatched(): Error
        +Cancel(): Error
    }
    class MatchProposal <<aggregate root>> {
        +Id: MatchProposalId
        +PublicId: Guid
        +ReturnRouteId: ReturnRouteId
        +ShipmentRequestId: ShipmentRequestId
        +ProposerUserId: UserId
        +ProposedByRole: ENegotiationParty
        +ProposedPrice: Money
        +Status: EProposalStatus
        +Accept(): Error
        +Reject(): Error
        +Cancel(): Error
    }
    class Message <<aggregate root>> {
        +Id: MessageId
        +MatchProposalId: MatchProposalId
        +SenderUserId: UserId
        +Kind: EMessageKind
        +Body: string?
        +CounterofferAmount: decimal?
    }
    interface IRouteMatchingService
    class RouteMatchingService <<domain service>> implements IRouteMatchingService
    interface IMatchmakingContextFacade
    MatchProposal --> ReturnRoute
    MatchProposal --> ShipmentRequest
    MatchProposal "1" -- "0..*" Message
    RouteMatchingService ..> ReturnRoute
    RouteMatchingService ..> ShipmentRequest
}

package "Execution Bounded Context" as Execution {
    class Trip <<aggregate root>> {
        +Id: long
        +PublicId: Guid
        +MatchProposalId: long
        +ReturnRouteId: long
        +ShipmentRequestId: long
        +CarrierUserId: long
        +MerchantUserId: long
        +VehicleId: long
        +DriverId: long?
        +AgreedPriceAmount: decimal
        +Status: ETripStatus
    }
    class TrackingPoint <<aggregate root>> {
        +Id: long
        +TripId: long
        +RecordedAt: DateTime
        +SpeedKmh: decimal?
        +DistanceFromCorridorMeters: decimal?
    }
    class DeviationAlert <<aggregate root>> {
        +Id: long
        +TripId: long
        +Severity: EAlertSeverity
        +DeviationDistanceMeters: decimal
    }
    class Incident <<aggregate root>> {
        +Id: long
        +TripId: long
        +ReportedByUserId: long
        +Category: EIncidentCategory
        +Severity: EIncidentSeverity
        +Status: EIncidentStatus
    }
    class IotDevice <<aggregate root>> {
        +Id: long
        +CarrierUserId: long
        +DeviceIdentifier: string
        +Status: EIotDeviceStatus
    }
    interface IExecutionContextFacade
    Trip "1" -- "0..*" TrackingPoint
    Trip "1" -- "0..*" DeviationAlert
    Trip "1" -- "0..*" Incident
}

package "Billing Bounded Context" as Billing {
    class Plan <<aggregate root>> {
        +Id: long
        +Code: EPlanCode
        +Name: string
        +MonthlyPriceAmount: decimal
        +MaxVehicles: int
    }
    class Subscription <<aggregate root>> {
        +Id: long
        +CarrierUserId: long
        +PlanId: long
        +Status: ESubscriptionStatus
        +CurrentPeriodStart: DateTime
        +CurrentPeriodEnd: DateTime
    }
    class SubscriptionPayment <<entity>> {
        +Id: long
        +SubscriptionId: long
        +Amount: decimal
        +Status: ESubscriptionPaymentStatus
    }
    class FreightSettlement <<aggregate root>> {
        +Id: long
        +TripId: long
        +CarrierUserId: long
        +MerchantUserId: long
        +GrossAmount: decimal
        +PlatformFeeAmount: decimal
        +CarrierNetAmount: decimal
        +Status: ESettlementStatus
    }
    class CancellationCompensation <<aggregate root>> {
        +Id: long
        +TripId: long
        +CompensationAmount: decimal
        +Status: ECompensationStatus
    }
    interface IBillingContextFacade
    Subscription --> Plan
    Subscription "1" *-- "0..*" SubscriptionPayment
}

package "Reputation Bounded Context" as Reputation {
    class Rating <<aggregate root>> {
        +Id: long
        +TripId: long
        +ReviewerUserId: long
        +ReviewedUserId: long
        +ReviewerRole: EReviewerRole
        +Stars: byte
        +Comment: string?
    }
    class LoyaltyPointEntry <<aggregate root>> {
        +Id: long
        +UserId: long
        +PointsDelta: int
        +BalanceAfter: int
        +Reason: ELoyaltyPointReason
    }
    interface IReputationContextFacade
}

User --|> AggregateRoot
ReturnRoute --|> AggregateRoot
ShipmentRequest --|> AggregateRoot
MatchProposal --|> AggregateRoot
Trip --|> AggregateRoot
Subscription --|> AggregateRoot
FreightSettlement --|> AggregateRoot
Rating --|> AggregateRoot

Matchmaking ..> IIamContextFacade
Matchmaking ..> IExecutionContextFacade
Execution ..> IMatchmakingContextFacade
Billing ..> IExecutionContextFacade
Reputation ..> IExecutionContextFacade

@enduml
